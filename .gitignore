# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# verification artifacts
verify-*.png
verify-*.mjs
debug-*.mjs
PLAN.md

# harness test artifacts (screenshots, scripts, fixtures)
harness/verify/
harness/fixtures/

# 시연 브랜치(agent/demo-network-density) 전용 검증 파일.
